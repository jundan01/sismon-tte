{
    if ($value !== null &amp;&amp; $value !== '') {
        $this-&gt;attributes['nik'] = \App\Services\Security\CryptoHelper::encryptField($value);
    }
}</code></pre>
                        </div>
                        <div class="code-box after">
                            <div class="code-box-header">Rekomendasi Perbaikan (PendaftaranTte.php)</div>
                            <pre><code>public function setNikAttribute(?string $value): void
{
    if ($value !== null &amp;&amp; $value !== '') {
        $this-&gt;attributes['nik'] = \App\Services\Security\CryptoHelper::encryptField($value);
    } else {
        $this-&gt;attributes['nik'] = null;
    }
}</code></pre>
