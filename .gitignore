# ==========================================
# Dependencies & Package Managers
# ==========================================
/node_modules
/vendor
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Environment & Secrets (Security Sensitive)
# ==========================================
.env
.env.backup
.env.production
.env.*.local
*.key
*.pem
*.pfx
*.cert
auth.json

# ==========================================
# Laravel Storage & Framework Cache
# ==========================================
/storage/*.key
/storage/app/*
!/storage/app/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/temp/*
!/storage/temp/.gitkeep

# Testing & Build Artifacts
.phpunit.result.cache
/public/build
/public/hot
/public/storage
laporan_audit.html

# ==========================================
# IDE & System Files
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
[Dd]esktop.ini

# ==========================================
# Dokumen Laporan, Artikel Ilmiah & Draft Riset
# ==========================================
*.docx
/AGENTIC AI Analisis Artikel/
/DOKUMEN LAPORAN & ARTIKEL/
/Progres/
AUDIT_ARTIKEL.MD
